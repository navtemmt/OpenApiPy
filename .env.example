# cTrader API Credentials Template
# Copy this to .env and fill in your actual values

# ------------------------------------------------------------------------------
# Global cTrader runtime settings
# ------------------------------------------------------------------------------
# Directory used to store per-account runtime token state files
CTRADER_TOKEN_STATE_DIR=runtime_tokens

# Force startup to use .env tokens instead of saved token state files
# 0 = use token state file first, then refresh, then .env fallback
# 1 = ignore token state file and use .env bootstrap tokens immediately
CTRADER_FORCE_ENV_TOKENS=0

# Delete saved token state file(s) on startup before loading credentials
# 0 = keep token state files
# 1 = remove token state files and bootstrap from .env again
CTRADER_CLEAR_TOKEN_STATE_ON_START=0

# Request timeout for Open API auth requests
CTRADER_AUTH_TIMEOUT_SEC=30

# Default timeout for general Open API requests
CTRADER_REQUEST_TIMEOUT_SEC=30


# ------------------------------------------------------------------------------
# Account naming convention
# ------------------------------------------------------------------------------
# Account variables use this pattern:
#   ACCOUNT_<NAME>_<FIELD>
#
# The <NAME> must match the account section name in accounts_config.ini
# Example:
#   [Account_Demo]
# requires:
#   ACCOUNT_DEMO_*
#
# Bootstrap behavior:
# - ACCESS_TOKEN and REFRESH_TOKEN are the initial recovery/bootstrap values
# - After successful refresh, runtime tokens should be written to TOKEN_STATE_FILE
# - On next startup the app should try TOKEN_STATE_FILE first, then refresh, then .env


# ------------------------------------------------------------------------------
# Account 1: Demo
# ------------------------------------------------------------------------------
ACCOUNT_DEMO_ACCOUNT_ID=your_account_id_here
ACCOUNT_DEMO_CLIENT_ID=your_client_id_here
ACCOUNT_DEMO_CLIENT_SECRET=your_client_secret_here

# Initial OAuth tokens from cTrader
ACCOUNT_DEMO_ACCESS_TOKEN=
ACCOUNT_DEMO_REFRESH_TOKEN=

# Optional explicit token state file path
# If blank in code, default can be runtime_tokens/Demo.json
ACCOUNT_DEMO_TOKEN_STATE_FILE=runtime_tokens/Demo.json


# ------------------------------------------------------------------------------
# Account 2: Broker2
# ------------------------------------------------------------------------------
ACCOUNT_BROKER2_ACCOUNT_ID=your_account_id_here
ACCOUNT_BROKER2_CLIENT_ID=your_client_id_here
ACCOUNT_BROKER2_CLIENT_SECRET=your_client_secret_here

# Initial OAuth tokens from cTrader
ACCOUNT_BROKER2_ACCESS_TOKEN=
ACCOUNT_BROKER2_REFRESH_TOKEN=

# Optional explicit token state file path
ACCOUNT_BROKER2_TOKEN_STATE_FILE=runtime_tokens/Broker2.json
